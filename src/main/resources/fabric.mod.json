{
  "schemaVersion": 1,
  "id": "maintena",
  "version": "${version}",
  "name": "Maintena",
  "description": "Server-side admin toolkit: maintenance mode, scheduled restarts and announcements, bans and IP bans, mutes, freeze, vanish, nicknames, disguises, command aliases and a settings menu. Supports LuckPerms.",
  "authors": ["crqzycat"],
  "contact": {
    "discord": "https://discord.gg/sTPjJc2bM5"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/maintena/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "crqzycat.maintena.Maintena"
    ]
  },
  "mixins": [
    "maintena.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "luckperms": "*"
  }
}
